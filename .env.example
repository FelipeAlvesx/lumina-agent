# ──────────────────────────────────────────────────
# Lumina Agent — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# ──────────────────────────────────────────────────

# ─── Anthropic (Claude) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (Whisper — transcrição de áudio, opcional) ───
# Deixe em branco para desabilitar transcrição de áudios.
OPENAI_API_KEY=

# Modelo padrão (opcional — o tenant YAML pode sobrescrever)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Evolution API (WhatsApp) ─────────────────────
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE=lumina-demo

# URL do agente que a Evolution vai chamar com mensagens recebidas.
# Dev local com ngrok: https://xxxx.ngrok-free.app
# Produção: https://seudominio.com
AGENT_WEBHOOK_URL=http://agent:3000

# ─── Google Calendar ──────────────────────────────
# Caminho para o arquivo de credenciais service account / OAuth
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_CALENDAR_ID=seu-calendario@gmail.com

# ─── Dashboard ────────────────────────────────────
# URL do agente vista pelo browser (não pelo container)
VITE_API_URL=http://localhost:3000
